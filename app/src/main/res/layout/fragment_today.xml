<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/today_fragment_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header_calendar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tv_selected_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lunes 1 Julio"
            android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tv_today_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_day_selector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:overScrollMode="never"
            android:clipToPadding="false"
            android:paddingVertical="4dp"
            android:paddingHorizontal="2dp"/>
    </LinearLayout>

    <!-- Lista de hábitos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_habits_today"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="80dp"/>

    <!-- Estado vacío y carga -->
    <ProgressBar
        android:id="@+id/progress_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tv_empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎉 No hay hábitos pendientes hoy"
        android:textAlignment="center"
        android:layout_marginTop="8dp"
        android:visibility="gone"/>


</LinearLayout>
