<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="16dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp">

        <!-- Nombre -->
        <com.google.android.material.textfield.TextInputLayout
            android:hint="Nombre del hábito" android:layout_height="match_parent" android:layout_width="match_parent">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>
        <Button
            android:id="@+id/btnScanText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📷 Escanear"
            android:layout_marginTop="8dp"
            android:layout_gravity="end" />


        <!-- Etiqueta frecuencia -->
        <TextView
            android:id="@+id/tv_days_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Frecuencia"
            android:layout_marginTop="12dp"
            android:textAppearance="?attr/textAppearanceSubtitle1" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/group_recurrence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_daily"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Daily" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_weekly"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Weekly" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_monthly"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Monthly" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_yearly"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Yearly" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Texto de días de la semana -->
        <TextView
            android:id="@+id/text_dias_semana"
            android:layout_marginTop="12dp"
            android:text="Días de la semana (si aplica):"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- Chips de días de la semana -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_weekdays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checkableBehavior="all" />

        <!-- Fecha de inicio -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_marginTop="12dp"
            android:hint="Fecha de inicio" android:layout_height="match_parent" android:layout_width="match_parent">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_start_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:inputType="none"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Fecha de finalización -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_marginTop="8dp"
            android:hint="Fecha de finalización (opcional)" android:layout_height="match_parent" android:layout_width="match_parent">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_end_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:inputType="none"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Recordatorios -->
        <TextView
            android:layout_marginTop="16dp"
            android:text="Recordatorios (horarios):"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_reminders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/btn_add_reminder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Añadir hora"/>

        <!-- Botón Guardar -->
        <Button
            android:id="@+id/btn_save"
            android:layout_marginTop="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar hábito"/>
    </LinearLayout>
</ScrollView>
