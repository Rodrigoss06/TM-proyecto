<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_username"
        android:text="Hola, Usuario"
        android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"  android:layout_height="match_parent" android:layout_width="match_parent"/>

    <TextView
        android:id="@+id/tv_total_habits"
        android:text="Total hábitos: 0"
        android:layout_marginTop="16dp"  android:layout_height="match_parent" android:layout_width="match_parent"/>

    <TextView
        android:id="@+id/tv_habits_completed"
        android:text="Hábitos completados: 0"   android:layout_height="match_parent" android:layout_width="match_parent"/>

    <TextView
        android:id="@+id/tv_current_streak"
        android:text="Racha actual: 0 🔥"  android:layout_height="match_parent" android:layout_width="match_parent" />

    <TextView
        android:id="@+id/tv_longest_streak"
        android:text="Mayor racha: 0 🏆" android:layout_height="match_parent" android:layout_width="match_parent" />

    <Switch
        android:id="@+id/switch_theme"
        android:layout_marginTop="24dp"
        android:text="Modo oscuro"  android:layout_height="match_parent" android:layout_width="match_parent"/>

    <Button
        android:id="@+id/btn_logout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cerrar sesión"
        android:layout_marginTop="16dp"/>
</LinearLayout>
